PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/style_fashion_db
# Set true only if your managed database requires SSL; Render Postgres commonly does.
PGSSL=true
CLIENT_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=sk_test_replace_me # server-side only; never expose to Vite
ADMIN_TOKEN=replace_with_a_long_random_secret
# Cloudinary image uploads (keep API secret on Render only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Marketplace JWT signing secret (generate a random value with at least 32 characters)
MARKETPLACE_AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_chars

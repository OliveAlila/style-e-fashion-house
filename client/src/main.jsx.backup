import React,{useEffect,useMemo,useState} from 'react';
import{createRoot}from'react-dom/client';
import{Search,ShoppingBag,Menu,X,ArrowUpRight,Plus,Minus,ArrowRight,Heart,CheckCircle2,PackageCheck,Instagram,ChevronDown,SlidersHorizontal}from'lucide-react';
import'./styles.css';
import logo from './style-logo.png';
const API=(import.meta.env.VITE_API_URL||'http://localhost:4000/api').replace(/\/$/,'');
const fallback=[
{id:1,name:'The Sunday Linen Set',category:'STYLE WOMAN',type:'Co-ord Set',price:4800,images:'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?auto=format&fit=crop&w=900&q=85',description:'An easy, elevated set for slow mornings and city afternoons.',sizes:['S','M','L','XL'],colors:['Sand','Black'],stock:12},
{id:2,name:'The Everyday Midi',category:'STYLE WOMAN',type:'Dress',price:3900,images:'https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=900&q=85',description:'A timeless silhouette made for everyday plans.',sizes:['S','M','L'],colors:['Cream','Olive'],stock:8},
{id:3,name:'Soft Knit Nursing Top',category:'STYLE MAMA',type:'Tops',price:2600,images:'https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=900&q=85',description:'A soft, comfortable wardrobe staple for busy days.',sizes:['S','M','L','XL'],colors:['Oat','Black'],stock:10},
{id:4,name:'Little Daydream Romper',category:'STYLE KIDS',type:'Kidswear',price:1850,images:'https://images.unsplash.com/photo-1519238263530-99f7f0a4c8a6?auto=format&fit=crop&w=900&q=85',description:'A sweet and practical piece for little adventures.',sizes:['0-6M','6-12M','1-2Y','3-4Y'],colors:['Butter','Sage'],stock:15},
{id:5,name:'Mama & Mini Matching Set',category:'SETS & GIFTS',type:'Matching Set',price:6200,images:'https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=900&q=85',description:'A coordinated look made for memories together.',sizes:['S/M','L/XL'],colors:['Cream','Terracotta'],stock:5},
{id:6,name:'The City Tailored Trouser',category:'STYLE WOMAN',type:'Trousers',price:3400,images:'https://images.unsplash.com/photo-1506629905607-d9b9b3e1e0b5?auto=format&fit=crop&w=900&q=85',description:'Clean lines and a comfortable fit for work and beyond.',sizes:['S','M','L','XL'],colors:['Charcoal','Sand'],stock:7},
{id:7,name:'Weekend Cotton Dress',category:'STYLE MAMA',type:'Dress',price:3200,images:'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=85',description:'Breathable cotton comfort with a polished finish.',sizes:['S','M','L'],colors:['Clay','Black'],stock:9},
{id:8,name:'Little Occasion Set',category:'STYLE KIDS',type:'Occasion Wear',price:2900,images:'https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=900&q=85',description:'A special little look for family celebrations.',sizes:['1-2Y','3-4Y','5-6Y'],colors:['Ivory','Blue'],stock:6}];
const money=n=>new Intl.NumberFormat('en-KE',{style:'currency',currency:'KES',maximumFractionDigits:0}).format(n);
function App(){
 const [products,setProducts]=useState(fallback),[category,setCategory]=useState('All'),[search,setSearch]=useState(''),[cart,setCart]=useState([]),[drawer,setDrawer]=useState(false),[selected,setSelected]=useState(null),[size,setSize]=useState(''),[color,setColor]=useState(''),[view,setView]=useState('home'),[sort,setSort]=useState('featured'),[notice,setNotice]=useState(''),[checkout,setCheckout]=useState({name:'',email:'',phone:'',address:'',town:'',county:'Nairobi',deliveryMethod:'standard'}),[busy,setBusy]=useState(false),[orderResult,setOrderResult]=useState(null),[adminToken,setAdminToken]=useState(''),[adminOrders,setAdminOrders]=useState([]),[adminMessage,setAdminMessage]=useState('');
 useEffect(()=>{fetch(`${API}/products`).then(r=>r.ok?r.json():Promise.reject()).then(setProducts).catch(()=>{});const params=new URLSearchParams(location.search);if(location.pathname==='/payment-return'){const ref=params.get('reference');if(ref)verifyPayment(ref);setView('return');}else if(location.pathname==='/admin')setView('admin');},[]);
 async function verifyPayment(ref){try{const r=await fetch(`${API}/paystack/verify/${encodeURIComponent(ref)}`);const d=await r.json();setOrderResult({reference:ref,paid:r.ok&&d.paid,error:d.error});setView('return');if(r.ok&&d.paid)setCart([]);}catch{setOrderResult({reference:ref,paid:false,error:'We could not confirm the payment yet. Please refresh in a moment.'});}}
 const shown=useMemo(()=>{let list=products.filter(p=>(category==='All'||p.category===category)&&`${p.name} ${p.description} ${p.type}`.toLowerCase().includes(search.toLowerCase()));if(sort==='price-low')list.sort((a,b)=>a.price-b.price);if(sort==='price-high')list.sort((a,b)=>b.price-a.price);return list},[products,category,search,sort]);
 const count=cart.reduce((s,i)=>s+i.quantity,0),subtotal=cart.reduce((s,i)=>s+i.price*i.quantity,0);
 const goShop=(cat='All')=>{setCategory(cat);setView('shop');setDrawer(false);window.scrollTo({top:0,behavior:'smooth'});};
 function addCart(p,s= p.sizes?.[0],c=p.colors?.[0]){if(!s||!c){setNotice('Please choose a size and colour.');return;}setCart(old=>{const found=old.find(i=>i.productId===p.id&&i.size===s&&i.color===c);return found?old.map(i=>i===found?{...i,quantity:Math.min(10,i.quantity+1)}:i):[...old,{key:`${p.id}-${s}-${c}`,productId:p.id,name:p.name,price:p.price,image:p.images,size:s,color:c,quantity:1}]});setNotice(`${p.name} added to your bag`);setDrawer(true);setSelected(null);}
 function openProduct(p){setSelected(p);setSize(p.sizes?.[0]||'');setColor(p.colors?.[0]||'');}
 function qty(key,d){setCart(old=>old.map(i=>i.key===key?{...i,quantity:i.quantity+d}:i).filter(i=>i.quantity>0));}
 async function submitCheckout(e){e.preventDefault();setBusy(true);setNotice('');try{const r=await fetch(`${API}/checkout`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({customer:{name:checkout.name,email:checkout.email,phone:checkout.phone,address:checkout.address,town:checkout.town,county:checkout.county},deliveryMethod:checkout.deliveryMethod,items:cart.map(i=>({productId:i.productId,quantity:i.quantity,size:i.size,color:i.color}))})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Checkout failed');if(d.checkoutUrl){window.location.href=d.checkoutUrl;return;}setOrderResult({reference:d.order.reference,paid:false,error:d.message||'Payment is not configured yet.'});setView('return');}catch(e){setNotice(e.message)}finally{setBusy(false)}}
 async function loadAdmin(e){e?.preventDefault();setAdminMessage('');try{const r=await fetch(`${API}/admin/orders`,{headers:{Authorization:`Bearer ${adminToken}`}});const d=await r.json();if(!r.ok)throw new Error(d.error);setAdminOrders(d);setAdminMessage('Orders loaded.');}catch(e){setAdminMessage(e.message)}}
 async function changeStatus(id,status){try{const r=await fetch(`${API}/admin/orders/${id}`,{method:'PATCH',headers:{'Content-Type':'application/json',Authorization:`Bearer ${adminToken}`},body:JSON.stringify({order_status:status})});const d=await r.json();if(!r.ok)throw new Error(d.error);setAdminOrders(old=>old.map(o=>o.id===id?d:o));}catch(e){setAdminMessage(e.message)}}
 return <><div className="announcement">A little something lovely, delivered across Kenya <span>✳</span> Shop the new season</div><header className="header"><button className="icon-btn mobile-menu" onClick={()=>setDrawer('menu')} aria-label="Open menu"><Menu/></button><nav className="nav-left"><button onClick={()=>goShop('STYLE WOMAN')}>WOMAN</button><button onClick={()=>goShop('STYLE MAMA')}>MAMA</button><button onClick={()=>goShop('STYLE KIDS')}>KIDS</button><button onClick={()=>goShop('SETS & GIFTS')}>SETS & GIFTS</button></nav><button className="brand" onClick={()=>{setView('home');setCategory('All');window.scrollTo({top:0,behavior:'smooth'})}} aria-label="STYLE home"><img src={logo} alt="STYLE E-Fashion House"/></button><div className="nav-right"><button className="search-trigger" onClick={()=>{setView('shop');document.getElementById('search-input')?.focus()}}><Search size={18}/><span>Search</span></button><button className="icon-btn bag-trigger" onClick={()=>setDrawer(true)} aria-label="Shopping bag"><ShoppingBag size={20}/><span className="bag-count">{count}</span></button></div></header>
 {view==='home'&&<><main><section className="hero"><div className="hero-image"></div><div className="hero-copy"><p className="eyebrow">DRESS FOR YOUR EVERYDAY</p><h1>Style for every<br/><em>chapter.</em></h1><p className="hero-text">Thoughtfully chosen pieces for her, for them, and for all the moments in between.</p><div className="hero-actions"><button className="btn btn-dark" onClick={()=>goShop('STYLE WOMAN')}>SHOP THE COLLECTION <ArrowUpRight size={16}/></button><button className="text-link" onClick={()=>goShop('All')}>Explore all styles <ArrowRight size={15}/></button></div><div className="hero-note"><span className="gold-dot"></span> HER STYLE. THEIR STYLE. YOUR STYLE.</div></div><div className="hero-index">01 <span></span> 03</div></section>
 <section className="trust-row"><div><PackageCheck/><span>Delivery across Kenya</span></div><div><CheckCircle2/><span>Thoughtfully selected</span></div><div><ShoppingBag/><span>Secure online checkout</span></div></section>
 <section className="collections section-wrap"><div className="section-heading"><div><p className="eyebrow">FIND YOUR FEEL</p><h2>Made for your <em>world.</em></h2></div><button className="text-link" onClick={()=>goShop('All')}>View all collections <ArrowRight size={16}/></button></div><div className="collection-grid"><button className="collection-card woman-card" onClick={()=>goShop('STYLE WOMAN')}><img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1000&q=85" alt="Women's fashion collection"/><span className="collection-label"><small>01 / THE EDIT</small><b>STYLE WOMAN</b><i>Explore collection <ArrowUpRight size={16}/></i></span></button><button className="collection-card mama-card" onClick={()=>goShop('STYLE MAMA')}><img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=900&q=85" alt="Comfortable everyday fashion"/><span className="collection-label"><small>02 / EVERY CHAPTER</small><b>STYLE MAMA</b><i>Explore collection <ArrowUpRight size={16}/></i></span></button><button className="collection-card kids-card" onClick={()=>goShop('STYLE KIDS')}><img src="https://images.unsplash.com/photo-1519238263530-99f7f0a4c8a6?auto=format&fit=crop&w=900&q=85" alt="Children's clothing"/><span className="collection-label"><small>03 / LITTLE MOMENTS</small><b>STYLE KIDS</b><i>Explore collection <ArrowUpRight size={16}/></i></span></button></div></section>
 <section className="new-arrivals section-wrap"><div className="section-heading"><div><p className="eyebrow">THE PIECES WE LOVE</p><h2>New arrivals <em>& favourites.</em></h2></div><button className="text-link" onClick={()=>goShop('All')}>Shop all pieces <ArrowRight size={16}/></button></div><ProductGrid products={products.slice(0,4)} openProduct={openProduct} addCart={addCart}/></section>
 <section className="quote-band"><span className="quote-mark">“</span><p>Getting dressed should feel like coming home to yourself.</p><span className="eyebrow">THE STYLE POINT OF VIEW</span></section>
 <section className="newsletter"><p className="eyebrow">A NOTE FROM STYLE</p><h2>A little more lovely<br/>in your <em>inbox.</em></h2><p>New arrivals, thoughtful edits, and first looks at what's next.</p><form onSubmit={e=>{e.preventDefault();setNotice('Thank you for your interest — newsletter sign-up can be connected before launch.')}}><input aria-label="Email address" placeholder="Your email address" type="email" required/><button aria-label="Subscribe"><ArrowRight/></button></form><small>By subscribing, you agree to receive updates from STYLE.</small></section></main><Footer goShop={goShop}/></>}
 {view==='shop'&&<main className="shop-page section-wrap"><div className="breadcrumbs">HOME / SHOP / <span>{category.toUpperCase()}</span></div><div className="shop-title"><div><p className="eyebrow">THE STYLE COLLECTION</p><h1>{category==='All'?'The collection':category.toLowerCase().replace(/\b\w/g,c=>c.toUpperCase())}<em>.</em></h1><p>Pieces for the way you live, move, and feel.</p></div><div className="shop-controls"><label className="search-box"><Search size={17}/><input id="search-input" value={search} onChange={e=>setSearch(e.target.value)} placeholder="Find your piece"/></label><label className="sort-select"><SlidersHorizontal size={16}/><select value={sort} onChange={e=>setSort(e.target.value)} aria-label="Sort products"><option value="featured">Featured</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option></select><ChevronDown size={14}/></label></div></div><div className="category-pills">{['All','STYLE WOMAN','STYLE MAMA','STYLE KIDS','SETS & GIFTS'].map(c=><button className={category===c?'active':''} key={c} onClick={()=>setCategory(c)}>{c}</button>)}</div><p className="result-count">{shown.length} thoughtfully chosen pieces</p><ProductGrid products={shown} openProduct={openProduct} addCart={addCart}/>{shown.length===0&&<div className="empty-state">No pieces found. Try another search or collection.</div>}</main>}
 {view==='checkout'&&<main className="checkout-page section-wrap"><div className="breadcrumbs">HOME / BAG / <span>CHECKOUT</span></div><h1>Almost <em>yours.</em></h1><p className="checkout-intro">Your details help us get your STYLE pieces to you.</p>{notice&&<div className="notice error">{notice}</div>}<div className="checkout-layout"><form className="checkout-form" onSubmit={submitCheckout}><section><div className="form-heading"><span>01</span><h3>Contact details</h3></div><label>Full name<input required value={checkout.name} onChange={e=>setCheckout({...checkout,name:e.target.value})} autoComplete="name"/></label><div className="form-two"><label>Email address<input required type="email" value={checkout.email} onChange={e=>setCheckout({...checkout,email:e.target.value})} autoComplete="email"/></label><label>Phone number<input required type="tel" placeholder="07xx xxx xxx" value={checkout.phone} onChange={e=>setCheckout({...checkout,phone:e.target.value})} autoComplete="tel"/></label></div></section><section><div className="form-heading"><span>02</span><h3>Delivery details</h3></div><label>Street address / building<input required value={checkout.address} onChange={e=>setCheckout({...checkout,address:e.target.value})} autoComplete="street-address"/></label><div className="form-two"><label>Town / city<input required value={checkout.town} onChange={e=>setCheckout({...checkout,town:e.target.value})}/></label><label>County<select required value={checkout.county} onChange={e=>setCheckout({...checkout,county:e.target.value})}>{['Nairobi','Mombasa','Kiambu','Nakuru','Kisumu','Uasin Gishu','Machakos','Kajiado','Nyeri','Other'].map(c=><option key={c}>{c}</option>)}</select></label></div><label className="delivery-option"><input type="radio" name="delivery" checked={checkout.deliveryMethod==='standard'} onChange={()=>setCheckout({...checkout,deliveryMethod:'standard'})}/><span><b>Standard delivery</b><small>Kenya delivery · KES 250</small></span><b>KES 250</b></label><label className="delivery-option"><input type="radio" name="delivery" checked={checkout.deliveryMethod==='express'} onChange={()=>setCheckout({...checkout,deliveryMethod:'express'})}/><span><b>Express delivery</b><small>Priority handling · KES 450</small></span><b>KES 450</b></label></section><button className="btn btn-dark checkout-submit" disabled={busy||!cart.length}>{busy?'Preparing secure checkout…':<>CONTINUE TO SECURE PAYMENT <ArrowRight size={17}/></>}</button><p className="secure-note"><CheckCircle2 size={15}/> Payment is processed securely by Paystack. Your order is confirmed after server-side payment verification.</p></form><aside className="order-summary"><h3>Your bag <span>({count})</span></h3>{cart.map(i=><div className="summary-item" key={i.key}><img src={i.image} alt=""/><div><b>{i.name}</b><small>{i.size} · {i.color} · Qty {i.quantity}</small><strong>{money(i.price*i.quantity)}</strong></div></div>)}<div className="summary-line"><span>Subtotal</span><b>{money(subtotal)}</b></div><div className="summary-line"><span>Delivery</span><b>{money(checkout.deliveryMethod==='standard'?250:450)}</b></div><div className="summary-line total"><span>Total</span><b>{money(subtotal+(checkout.deliveryMethod==='standard'?250:450))}</b></div><small className="tax-note">Total shown in KES. No payment is taken until you continue to Paystack.</small></aside></div></main>}
 {view==='return'&&<main className="return-page"><div className="return-icon"><CheckCircle2 size={34}/></div><p className="eyebrow">YOUR STYLE ORDER</p><h1>{orderResult?.paid?"It's official.":"our order is being checked."}</h1><p>{orderResult?.paid?'Thank you. Your payment has been verified and your order is now processing.':orderResult?.error||'We are confirming the payment status securely. Please do not place a second order yet.'}</p>{orderResult?.reference&&<div className="reference-box"><small>ORDER REFERENCE</small><b>{orderResult.reference}</b><button onClick={()=>navigator.clipboard?.writeText(orderResult.reference)}>Copy reference</button></div>}<button className="btn btn-dark" onClick={()=>{setView('home');setOrderResult(null);window.history.replaceState({},'', '/')}}>BACK TO STYLE <ArrowRight size={16}/></button></main>}
 {view==='admin'&&<main className="admin-page section-wrap"><p className="eyebrow">STYLE OPERATIONS</p><h1>Order <em>desk.</em></h1><p>Private admin view. Use the ADMIN_TOKEN configured on the API server.</p><form className="admin-login" onSubmit={loadAdmin}><input type="password" value={adminToken} onChange={e=>setAdminToken(e.target.value)} placeholder="Admin token" required/><button className="btn btn-dark">LOAD ORDERS</button></form>{adminMessage&&<p className="admin-message">{adminMessage}</p>}<div className="admin-table-wrap"><table><thead><tr><th>Reference</th><th>Customer</th><th>Total</th><th>Payment</th><th>Order status</th><th>Update status</th></tr></thead><tbody>{adminOrders.map(o=><tr key={o.id}><td>{o.reference}</td><td>{o.customer_name}<small>{o.email}</small></td><td>{money(Number(o.total))}</td><td>{o.payment_status}</td><td>{o.order_status}</td><td><select value={o.order_status} onChange={e=>changeStatus(o.id,e.target.value)} disabled={o.payment_status!=='paid'}><option value="processing">Processing</option><option value="dispatched">Dispatched</option><option value="delivered">Delivered</option><option value="cancelled">Cancelled</option><option value="refunded">Refunded</option></select></td></tr>)}</tbody></table></div></main>}
 {selected&&<div className="modal-backdrop" onClick={()=>setSelected(null)}><div className="product-modal" onClick={e=>e.stopPropagation()}><button className="modal-close icon-btn" onClick={()=>setSelected(null)} aria-label="Close"><X/></button><div className="modal-image"><img src={selected.images} alt={selected.name}/></div><div className="modal-details"><p className="eyebrow">{selected.category}</p><h2>{selected.name}</h2><strong className="modal-price">{money(selected.price)}</strong><p>{selected.description}</p><div className="choice-group"><span>Size</span><div className="choice-options">{selected.sizes?.map(s=><button key={s} className={size===s?'chosen':''} onClick={()=>setSize(s)}>{s}</button>)}</div></div><div className="choice-group"><span>Colour · {color}</span><div className="choice-options">{selected.colors?.map(c=><button key={c} className={color===c?'chosen':''} onClick={()=>setColor(c)}>{c}</button>)}</div></div><p className="stock-note">{selected.stock>0?'Available to order · Stock is confirmed during processing':'Availability will be confirmed before dispatch'}</p><button className="btn btn-dark modal-add" onClick={()=>addCart(selected,size,color)}>ADD TO BAG — {money(selected.price)} <ShoppingBag size={17}/></button><p className="returns-note">Delivery across Kenya · Secure checkout · Easy-to-read policies</p></div></div></div>}
 {drawer&&<div className="drawer-backdrop" onClick={()=>setDrawer(false)}><aside className="cart-drawer" onClick={e=>e.stopPropagation()}><div className="drawer-head"><div><p className="eyebrow">YOUR SELECTION</p><h2>{drawer==='menu'?'Explore STYLE':'Your bag'} <span>({count})</span></h2></div><button className="icon-btn" onClick={()=>setDrawer(false)} aria-label="Close"><X/></button></div>{drawer==='menu'?<nav className="mobile-drawer-nav">{['STYLE WOMAN','STYLE MAMA','STYLE KIDS','SETS & GIFTS','All'].map(c=><button key={c} onClick={()=>goShop(c)}>{c}<ArrowRight/></button>)}</nav>:<>{cart.length===0?<div className="cart-empty"><ShoppingBag size={36}/><h3>Your bag is waiting.</h3><p>Find something that feels like you.</p><button className="btn btn-dark" onClick={()=>{setDrawer(false);goShop('All')}}>EXPLORE THE COLLECTION</button></div>:<><div className="cart-items">{cart.map(i=><div className="cart-item" key={i.key}><img src={i.image} alt={i.name}/><div className="cart-item-info"><b>{i.name}</b><small>{i.size} · {i.color}</small><strong>{money(i.price)}</strong><div className="quantity"><button onClick={()=>qty(i.key,-1)} aria-label="Decrease quantity"><Minus size={13}/></button><span>{i.quantity}</span><button onClick={()=>qty(i.key,1)} aria-label="Increase quantity"><Plus size={13}/></button><button className="remove-item" onClick={()=>setCart(old=>old.filter(x=>x.key!==i.key))}>Remove</button></div></div></div>)}</div><div className="drawer-bottom"><div className="summary-line"><span>Subtotal</span><b>{money(subtotal)}</b></div><small>Delivery is calculated at checkout.</small><button className="btn btn-dark checkout-btn" onClick={()=>{setDrawer(false);setView('checkout');window.scrollTo(0,0)}}>CONTINUE TO CHECKOUT <ArrowRight size={17}/></button><button className="continue-shopping" onClick={()=>{setDrawer(false);goShop('All')}}>Continue shopping</button></div></>}</>}</aside></div>}
 {notice&&view!=='checkout'&&<button className="toast" onClick={()=>setNotice('')}>{notice}<X size={14}/></button>}
 </>}
function ProductGrid({products,openProduct,addCart}){return <div className="product-grid">{products.map((p,i)=><article className="product-card" key={p.id}><button className="product-photo" onClick={()=>openProduct(p)}><img src={p.images} alt={p.name} loading={i>2?'lazy':'eager'}/>{i===0&&<span className="product-badge">STYLE PICK</span>}<span className="quick-add">QUICK VIEW <ArrowUpRight size={14}/></span></button><div className="product-meta"><div><small>{p.category}</small><h3><button onClick={()=>openProduct(p)}>{p.name}</button></h3></div><strong>{money(p.price)}</strong></div><button className="product-add" onClick={()=>addCart(p)}>ADD TO BAG <Plus size={14}/></button></article>)}</div>}
function Footer({goShop}){return <footer className="footer"><div className="footer-main"><div className="footer-brand"><img src={logo} alt="STYLE E-Fashion House"/><p>Her Style. Their Style. Your Style.</p><span>Thoughtfully chosen, always you.</span></div><div><h4>EXPLORE</h4><button onClick={()=>goShop('STYLE WOMAN')}>STYLE WOMAN</button><button onClick={()=>goShop('STYLE MAMA')}>STYLE MAMA</button><button onClick={()=>goShop('STYLE KIDS')}>STYLE KIDS</button><button onClick={()=>goShop('SETS & GIFTS')}>SETS & GIFTS</button></div><div><h4>HERE TO HELP</h4><a href="mailto:hello@stylefashion.co.ke">Contact us</a><a href="#delivery">Delivery information</a><a href="#returns">Returns & exchanges</a><a href="#faq">Frequently asked questions</a></div><div><h4>THE DETAILS</h4><a href="#privacy">Privacy policy</a><a href="#terms">Terms & conditions</a><p className="footer-kenya">Proudly serving Kenya<br/>Prices in KES (KSh)</p></div></div><div className="footer-bottom"><span>© {new Date().getFullYear()} STYLE E-FASHION HOUSE</span><span>MADE FOR EVERY CHAPTER <Heart size={12}/></span><span className="social"><Instagram size={15}/> FOLLOW OUR STORY</span></div></footer>}

createRoot(document.getElementById('root')).render(<App/>);

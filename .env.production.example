# =====================================================
# STYLE E-Fashion House - Production Environment
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME_secure_database_password_here
POSTGRES_DB=style_fashion_db
DATABASE_URL=postgresql://root:CHANGE_ME_secure_database_password_here@db:5432/style_fashion_db
PGSSL=false

# For external PostgreSQL (if not using Docker):
# DATABASE_URL=postgresql://username:password@host:5432/database_name
# PGSSL=true

# =====================================================
# AUTHENTICATION & SECURITY
# =====================================================
# Admin API Bearer token (minimum 32 characters)
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=CHANGE_ME_minimum_32_characters_secure_random_string

# Marketplace JWT secret (minimum 32 characters)
# Generate with: openssl rand -base64 48
MARKETPLACE_AUTH_SECRET=CHANGE_ME_minimum_32_characters_for_jwt_signing

# =====================================================
# PAYSTACK PAYMENT GATEWAY
# =====================================================
# Sign up at: https://paystack.com
# Get keys from: https://dashboard.paystack.com/#/settings/developers
# Use test keys for staging, live keys for production

# Test Secret Key (for development/staging)
# PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key_here

# Live Secret Key (for production)
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME_your_live_secret_key_here

# =====================================================
# CLOUDINARY IMAGE UPLOADS
# =====================================================
# Sign up at: https://cloudinary.com
# Get credentials from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=CHANGE_ME_your_cloud_name
CLOUDINARY_API_KEY=CHANGE_ME_your_api_key
CLOUDINARY_API_SECRET=CHANGE_ME_your_api_secret

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
NODE_ENV=production
PORT=4000

# Your production domain (used for CORS and Paystack callbacks)
# Examples: https://stylefashion.com, https://api.stylefashion.com
CLIENT_URL=https://CHANGE_ME_your_domain.com

# =====================================================
# OPTIONAL: PGADMIN (Database Management UI)
# =====================================================
# Only needed if you want to use pgAdmin in docker-compose
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# =====================================================
# OPTIONAL: DATA PATH (for production volume mounts)
# =====================================================
# Where to store persistent data in production
DATA_PATH=./data

# =====================================================
# DEPLOYMENT NOTES
# =====================================================
# 1. Replace ALL "CHANGE_ME" values before deploying
# 2. Generate secure random strings for tokens/secrets
# 3. Use strong database passwords (16+ characters)
# 4. Keep this file secure and never commit to git
# 5. Use different credentials for staging vs production
# 6. Regularly rotate secrets and passwords
# =====================================================
